{
  // Typechecks the tests, which `tsconfig.json` leaves out of `dist`. `bun test`
  // runs them without typechecking.
  "extends": "./tsconfig.json",
  "include": ["src"],
  "exclude": [],
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "types": ["bun"]
  }
}
